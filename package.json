{
  "name": "ccnexus",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Claude Code visual client — chat-based UI with diff view, file tree, and session management",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node --watch server/index.js\" \"vite --port 5000 --host 0.0.0.0\"",
    "build": "vite build",
    "test:protocol": "node --test",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.218",
    "concurrently": "^9.0.0",
    "diff": "^7.0.0",
    "diff2html": "^3.4.48",
    "dompurify": "^3.4.12",
    "express": "^4.21.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.26.0",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "sql.js": "^1.14.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "highlight.js": "^11.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
